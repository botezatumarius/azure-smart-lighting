[Unit]
Description=Smart Lighting VM detector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azureuser
WorkingDirectory=/home/azureuser/smart-lighting
Environment=PYTHONUNBUFFERED=1
Environment=MPLCONFIGDIR=/home/azureuser/smart-lighting/tmp/matplotlib
ExecStart=/home/azureuser/smart-lighting/.venv/bin/python -m smart_lighting serve
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=multi-user.target
